<div class="crafting-window-content">
  <div class="form-group">
    <div class="form-fields">
        {{#if displaySearchBar}}
          <span
            id="toggle-search-logic"
            data-action="toggleSearchLogic"
            class="search-logic-toggle {{#if matchAll}}match-all{{else}}match-any{{/if}}"
            title="{{#if matchAll}}{{localize "HelianasHarvest.SearchLogicAND"}}{{else}}{{localize "HelianasHarvest.SearchLogicOR"}}{{/if}}">
            {{#if matchAll}}
              {{localize "HelianasHarvest.SearchLogicAND"}}
            {{else}}
              {{localize "HelianasHarvest.SearchLogicOR"}}
            {{/if}}
          </span>
        {{/if}}
      <input
        type={{ifThen displaySearchBar "text" "hidden"}}
        class="managed-input debounce form-control"
        id="recipe-search"
        value="{{searchText}}"
        data-binding="searchText"
        placeholder="{{localize "HelianasHarvest.RecipeSearch"}}"
      />
    </div>
  </div>
  <table>
    <thead data-action="sortBy">
      <tr>
        <th scope="col" class="{{#if (eq sortBy 0)}}sorted-column{{#if reverseSort}} reverse{{/if}}{{/if}}">{{localize "HelianasHarvest.ItemNameHeader"}}</th>
        <th scope="col" class="{{#if (eq sortBy 1)}}sorted-column{{#if reverseSort}} reverse{{/if}}{{/if}}">{{localize "HelianasHarvest.ItemRarity"}}</th>
        <th scope="col" class="{{#if (eq sortBy 2)}}sorted-column{{#if reverseSort}} reverse{{/if}}{{/if}}">{{localize "HelianasHarvest.ItemPriceHeader"}}</th>
        <th scope="col" class="{{#if (eq sortBy 3)}}sorted-column{{#if reverseSort}} reverse{{/if}}{{/if}}">{{localize "HelianasHarvest.RecipeMetatag"}}</th>
        <th scope="col" class="{{#if (eq sortBy 4)}}sorted-column{{#if reverseSort}} reverse{{/if}}{{/if}}">{{localize "HelianasHarvest.RequiredComponents"}}</th>
        {{#if showHeldComponents}}
        <th scope="col" class="filter-column{{#if filterComponentsHeld}} active{{/if}}" data-action="toggleFilterComponentsHeld" title="{{localize "HelianasHarvest.FilterComponents"}}">
          {{localize "HelianasHarvest.HeldComponents"}}
          <input type="checkbox" class="helianas-harvesting-module filter-checkbox" id="filterComponentsHeld" name="filterComponentsHeld" data-dtype="Boolean" {{checked filterComponentsHeld}}>
        </th>
        {{/if}}
      </tr>
    </thead>
    <tbody>
      {{#each recipes}}
        <tr class="harvest-table-row">
          <td>
            <a
              class="recipe-item-name display-image-name"
              data-item-name="{{ this.name }}"
              data-item-link="{{ this.link }}"
              data-action="openRecipe"
            >
              <img
                src="{{this.img}}"
                alt="{{this.name}}"
                style="max-height: 2rem;"
              />
              <div>
                {{this.name}}
                {{#if (gt this.qty 1)}} (x{{this.qty}}) {{/if}}
              </div>
            </a>
          </td>
          <td style="text-align: center;">
            {{ getProperty ../rarityNames this.rarity }}
          </td>
          <td style="text-align: right;">
            {{ this.price }}
          </td>
          <td style="text-align: center;">
            {{ this.metatag }}
          </td>
          <td>
            {{#each this.components}}
              <p class="display-image-name">
                <img src="{{ this.img }}" style="max-height: 1rem"/>
                <span>{{this.name}}</span>
              </p>
            {{/each}}
          </td>
          <td>
            {{#if ../showHeldComponents}}
              {{#each this.components}}
                {{#if this.held.items}}
                  <p><strong>{{this.held.count}} {{localize "HelianasHarvest.InInventory"}}</p></strong>
                  {{#each this.held.items}}
                    {{#if this.parent}}
                      <p>{{this.parent.name}} : {{this.name}} : {{this.system.quantity}}</p>
                    {{/if}}
                  {{/each}}
                {{/if}}
              {{/each}}
            {{/if}}
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>
